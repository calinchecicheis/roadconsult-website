---
// Design concept B, "Șantier": signal yellow and black, condensed display type, built for impact.
import '@fontsource-variable/archivo/standard.css';
import ConceptLayout from '../../../layouts/ConceptLayout.astro';
import PHOTOS from '../../../data/photos.json';
import { SITE, ADDRESS_LINE } from '../../../config';
import { EQUIPMENT, ROUTES, SERVICE_KEYS, T } from '../../../i18n';
const t = T.ro;
const P = PHOTOS as Record<string, { src: string; sm: string; w: number; h: number }[]>;
const hero = P['dumbravita-modernizare'][9];
const shots = [
  { p: P['arad'][3], place: 'Arad', what: 'Întreținere drumuri județene' },
  { p: P['biled'][0], place: 'Biled', what: 'Drumuri de acces agricol' },
  { p: P['dumbravita-modernizare'][0], place: 'Dumbrăvița', what: 'Modernizare străzi' },
  { p: P['saravale'][9], place: 'Săravale', what: 'Asfaltare străzi și accese' },
];
---

<ConceptLayout title="Concept B · Șantier | Road Consult">
  <header class="top">
    <a href="#" class="logo" aria-label="Road Consult"></a>
    <nav>
      <a href="#servicii">Servicii</a>
      <a href="#proiecte">Proiecte</a>
      <a href="#echipamente">Echipamente</a>
      <a href="#contact">Contact</a>
    </nav>
    <a class="call" href={SITE.whatsapp}>{SITE.phoneDisplay}</a>
  </header>

  <section class="hero">
    <div class="hero-copy">
      <h1>Drumuri trasate corect de la primul țăruș.</h1>
      <p class="lead">Măsurători topografice, planificare și coordonare de șantier pentru lucrări de drumuri. Din 2017, din Marghita, cu echipamente Leica.</p>
      <div class="ctas">
        <a class="btn black" href={ROUTES.contact.ro}>Cere o ofertă</a>
        <a class="btn ghost" href={SITE.whatsapp}>Scrie-ne pe WhatsApp</a>
      </div>
    </div>
    <figure class="hero-photo">
      <img src={hero.src} width={hero.w} height={hero.h} alt="Topograf cu stația totală Leica, pe o stradă modernizată în Dumbrăvița" />
    </figure>
  </section>
  <div class="hazard" aria-hidden="true"></div>

  <section class="services" id="servicii">
    <h2 class="sec">Ce facem</h2>
    <ul>
      {
        SERVICE_KEYS.map((k) => (
          <li>
            <a href={ROUTES[k].ro}>
              <span class="s-title">{t.services[k].title}</span>
              <span class="s-text">{t.services[k].short}</span>
              <span class="s-arrow" aria-hidden="true">
                <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="square"><path d="M5 12h13M12 5l7 7-7 7" /></svg>
              </span>
            </a>
          </li>
        ))
      }
    </ul>
  </section>

  <section class="projects" id="proiecte">
    <div class="p-head">
      <h2 class="sec">Pe teren</h2>
      <a class="link" href={ROUTES.projects.ro}>Toate proiectele</a>
    </div>
    <div class="p-grid">
      {
        shots.map((s, i) => (
          <a href={ROUTES.projects.ro} class:list={['shot', `s${i}`]}>
            <img src={i === 0 ? s.p.src : s.p.sm} alt={`${s.what}, ${s.place}`} loading="lazy" />
            <span class="cap">
              <strong>{s.place}</strong>
              {s.what}
            </span>
          </a>
        ))
      }
    </div>
  </section>

  <section class="kit" id="echipamente">
    <h2 class="sec">Echipamente</h2>
    <div class="kit-row">
      {
        EQUIPMENT.map((e) => (
          <div>
            <p class="kit-kind">{t.equipment[e.key].kind}</p>
            <p class="kit-name">{e.name.replace('Leica ', '')}</p>
            <p class="kit-text">{t.equipment[e.key].text}</p>
          </div>
        ))
      }
    </div>
  </section>

  <section class="story">
    <p class="big">MC Compas Road Consult face inginerie și consultanță tehnică pentru drumuri din 2017. Tratăm fiecare proiect ca unic și îl livrăm la termen, în bugetul stabilit.</p>
    <a class="link" href={ROUTES.about.ro}>Despre noi</a>
  </section>

  <section class="cta" id="contact">
    <h2>Ai un drum de măsurat?</h2>
    <a class="phone" href={SITE.whatsapp}>{SITE.phoneDisplay}</a>
    <p>Sună sau scrie-ne pe WhatsApp. Sau trimite detaliile proiectului și revenim cu o ofertă.</p>
    <a class="btn black" href={ROUTES.contact.ro}>Trimite cererea de ofertă</a>
  </section>

  <footer class="foot">
    <span class="logo small" aria-hidden="true"></span>
    <p>{SITE.legalName} · CUI {SITE.cui} · {SITE.reg}<br />{ADDRESS_LINE} · <a href={`mailto:${SITE.email}`}>{SITE.email}</a></p>
  </footer>
</ConceptLayout>

<style is:global>
  :root {
    --y: #ffc400;
    --k: #000000;
    --w: #ffffff;
    --g: #6e6e6e;
    --pad: clamp(16px, 4vw, 56px);
  }
  * {
    box-sizing: border-box;
  }
  body {
    margin: 0;
    font-family: 'Archivo Variable', system-ui, sans-serif;
    font-variation-settings: 'wdth' 100;
    background: var(--w);
    color: var(--k);
    line-height: 1.55;
  }
  img {
    display: block;
    max-width: 100%;
  }
  a {
    color: inherit;
  }
  :focus-visible {
    outline: 3px solid var(--k);
    outline-offset: 3px;
  }
  .top {
    position: sticky;
    top: 0;
    z-index: 5;
    display: flex;
    align-items: center;
    gap: 32px;
    padding: 14px var(--pad);
    background: var(--k);
    color: var(--w);
  }
  .logo {
    display: block;
    height: 30px;
    aspect-ratio: 425 / 80;
    background: currentColor;
    -webkit-mask: url('/logo.webp') left center / contain no-repeat;
    mask: url('/logo.webp') left center / contain no-repeat;
  }
  .top nav {
    display: flex;
    gap: 24px;
    margin-left: auto;
    font-weight: 600;
  }
  .top nav a {
    text-decoration: none;
  }
  .top nav a:hover {
    color: var(--y);
  }
  .call {
    background: var(--y);
    color: var(--k);
    padding: 10px 16px;
    font-weight: 800;
    text-decoration: none;
    font-variant-numeric: tabular-nums;
  }
  .hero {
    display: grid;
    grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
    background: var(--y);
    min-height: calc(100vh - 58px - 28px);
  }
  .hero-copy {
    padding: clamp(40px, 7vw, 96px) var(--pad);
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    gap: 28px;
  }
  h1 {
    margin: 0;
    font-size: clamp(56px, 9.5vw, 156px);
    line-height: 0.86;
    letter-spacing: -0.02em;
    font-weight: 850;
    font-variation-settings: 'wdth' 62;
    text-transform: uppercase;
  }
  .lead {
    margin: 0;
    font-size: clamp(18px, 1.6vw, 22px);
    max-width: 32em;
  }
  .ctas {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
  }
  .btn {
    display: inline-flex;
    align-items: center;
    min-height: 54px;
    padding: 0 26px;
    font-weight: 800;
    font-size: 17px;
    text-decoration: none;
    border: 3px solid var(--k);
  }
  .btn.black {
    background: var(--k);
    color: var(--y);
  }
  .btn.black:hover {
    background: transparent;
    color: var(--k);
  }
  .btn.ghost:hover {
    background: var(--k);
    color: var(--y);
  }
  .hero-photo {
    margin: 0;
    position: relative;
  }
  .hero-photo img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 30% center;
  }
  .hazard {
    height: 28px;
    background: repeating-linear-gradient(-45deg, var(--k) 0 22px, var(--y) 22px 44px);
  }
  .sec {
    margin: 0;
    font-size: clamp(40px, 6vw, 88px);
    line-height: 0.9;
    font-weight: 850;
    font-variation-settings: 'wdth' 62;
    text-transform: uppercase;
  }
  .services {
    background: var(--k);
    color: var(--w);
    padding: clamp(64px, 9vw, 128px) var(--pad);
  }
  .services ul {
    list-style: none;
    margin: 48px 0 0;
    padding: 0;
    border-top: 2px solid #2a2a2a;
  }
  .services a {
    display: grid;
    grid-template-columns: minmax(0, 6fr) minmax(0, 5fr) 48px;
    gap: 24px;
    align-items: center;
    padding: 32px 0;
    border-bottom: 2px solid #2a2a2a;
    text-decoration: none;
  }
  .s-title {
    font-size: clamp(32px, 4.4vw, 64px);
    line-height: 1;
    font-weight: 800;
    font-variation-settings: 'wdth' 70;
  }
  .s-text {
    color: #b9b9b9;
    font-size: 17px;
  }
  .s-arrow {
    color: var(--y);
    transition: transform 0.2s ease;
  }
  .services a:hover .s-title {
    color: var(--y);
  }
  .services a:hover .s-arrow {
    transform: translateX(8px);
  }
  .projects {
    padding: clamp(64px, 9vw, 128px) var(--pad);
  }
  .p-head {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    gap: 24px;
    margin-bottom: 40px;
  }
  .link {
    font-weight: 800;
    text-decoration: none;
    border-bottom: 4px solid var(--y);
    padding-bottom: 2px;
  }
  .p-grid {
    display: grid;
    grid-template-columns: 2fr 1fr 1fr;
    grid-template-rows: 300px 300px;
    gap: 8px;
  }
  .shot {
    position: relative;
    overflow: hidden;
    background: #ddd;
  }
  .shot img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .s0 {
    grid-row: span 2;
  }
  .s3 {
    grid-column: span 2;
  }
  .cap {
    position: absolute;
    left: 0;
    bottom: 0;
    background: var(--y);
    padding: 10px 14px;
    font-size: 14px;
    display: flex;
    flex-direction: column;
    line-height: 1.25;
  }
  .cap strong {
    font-size: 22px;
    font-weight: 850;
    font-variation-settings: 'wdth' 70;
    text-transform: uppercase;
  }
  .kit {
    padding: 0 var(--pad) clamp(64px, 9vw, 128px);
  }
  .kit-row {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    margin-top: 40px;
    border-top: 6px solid var(--k);
  }
  .kit-row > div {
    padding: 24px 24px 0 0;
  }
  .kit-row > div + div {
    padding-left: 24px;
    border-left: 2px solid var(--k);
  }
  .kit-kind {
    margin: 0;
    font-weight: 700;
    color: var(--g);
  }
  .kit-name {
    margin: 4px 0 10px;
    font-size: clamp(30px, 3.4vw, 48px);
    line-height: 1;
    font-weight: 850;
    font-variation-settings: 'wdth' 62;
  }
  .kit-text {
    margin: 0;
  }
  .story {
    background: var(--k);
    color: var(--w);
    padding: clamp(64px, 9vw, 128px) var(--pad);
    display: flex;
    flex-direction: column;
    gap: 32px;
    align-items: flex-start;
  }
  .big {
    margin: 0;
    font-size: clamp(26px, 3.2vw, 44px);
    line-height: 1.2;
    max-width: 26em;
    font-weight: 500;
  }
  .cta {
    background: var(--y);
    padding: clamp(64px, 9vw, 128px) var(--pad);
    display: flex;
    flex-direction: column;
    gap: 20px;
    align-items: flex-start;
  }
  .cta h2 {
    margin: 0;
    font-size: clamp(28px, 3vw, 40px);
    font-weight: 800;
  }
  .phone {
    font-size: clamp(64px, 13vw, 200px);
    line-height: 0.85;
    font-weight: 900;
    font-variation-settings: 'wdth' 62;
    text-decoration: none;
    font-variant-numeric: tabular-nums;
    letter-spacing: -0.01em;
  }
  .phone:hover {
    text-decoration: underline;
    text-decoration-thickness: 8px;
  }
  .cta p {
    margin: 0;
    font-size: 19px;
    max-width: 34em;
  }
  .foot {
    background: var(--k);
    color: #b9b9b9;
    padding: 40px var(--pad);
    display: flex;
    flex-wrap: wrap;
    gap: 24px;
    align-items: center;
    justify-content: space-between;
    font-size: 14px;
  }
  .foot p {
    margin: 0;
  }
  .logo.small {
    color: var(--w);
    height: 24px;
  }
  @media (max-width: 900px) {
    .top nav {
      display: none;
    }
    .call {
      margin-left: auto;
    }
    .hero {
      grid-template-columns: minmax(0, 1fr);
      min-height: 0;
    }
    .hero-photo {
      aspect-ratio: 4 / 3;
    }
    .services a {
      grid-template-columns: minmax(0, 1fr) 40px;
    }
    .s-text {
      grid-column: 1;
    }
    .p-grid {
      grid-template-columns: 1fr 1fr;
      grid-template-rows: 260px 200px 200px;
    }
    .s0 {
      grid-column: span 2;
      grid-row: span 1;
    }
    .s3 {
      grid-column: span 2;
    }
    .kit-row {
      grid-template-columns: minmax(0, 1fr);
    }
    .kit-row > div + div {
      padding-left: 0;
      border-left: 0;
      border-top: 2px solid var(--k);
      margin-top: 24px;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .s-arrow {
      transition: none;
    }
  }
</style>
