---
// Design concept C, "Indicator": calm and corporate, photo-led, with the services set as
// road direction signs (the one bold element).
import '@fontsource-variable/schibsted-grotesk';
import ConceptLayout from '../../../layouts/ConceptLayout.astro';
import PHOTOS from '../../../data/photos.json';
import { SITE, ADDRESS_LINE } from '../../../config';
import { EQUIPMENT, ROUTES, SERVICE_KEYS, T } from '../../../i18n';
const t = T.ro;
const P = PHOTOS as Record<string, { src: string; sm: string; w: number; h: number }[]>;
const hero = P['arad'][3];
const level = P['dumbravita-modernizare'][2];
const projects = t.projects.items.map((p) => ({ ...p, photo: P[p.gallery][0] }));
---

<ConceptLayout title="Concept C · Indicator | Road Consult">
  <header class="top">
    <a href="#" class="logo" aria-label="Road Consult"></a>
    <nav>
      <a href="#servicii">Servicii</a>
      <a href="#proiecte">Proiecte</a>
      <a href="#echipamente">Echipamente</a>
      <a href="#despre">Despre noi</a>
    </nav>
    <a class="btn small" href="#contact">Cere ofertă</a>
  </header>

  <section class="hero">
    <img class="hero-img" src={hero.src} width={hero.w} height={hero.h} alt="Lucrări de întreținere pe un drum județean din județul Arad" />
    <div class="hero-shade" aria-hidden="true"></div>
    <div class="wrap hero-copy">
      <h1>Inginerie și consultanță tehnică pentru drumuri</h1>
      <p>Măsurători topografice, planificare și coordonare de șantier. Lucrări livrate la termen și în bugetul stabilit, din 2017.</p>
    </div>
  </section>

  <section class="signs wrap" id="servicii" aria-label="Servicii">
    {
      SERVICE_KEYS.map((k) => (
        <a class="sign" href={ROUTES[k].ro}>
          <span class="sign-in">
            <span class="sign-title">{t.services[k].title}</span>
            <span class="sign-text">{t.services[k].short}</span>
          </span>
          <svg class="sign-arrow" viewBox="0 0 24 24" aria-hidden="true"><path d="M4 10h10V5l7 7-7 7v-5H4z" /></svg>
        </a>
      ))
    }
  </section>

  <section class="wrap intro">
    <p class="intro-big">Tratăm fiecare proiect ca unic. Trasăm obiectivele în teren, urmărim execuția zi de zi și ținem documentația la zi, ca beneficiarul să știe oricând unde se află lucrarea.</p>
    <dl class="facts">
      <div><dt>Înființată</dt><dd>2017</dd></div>
      <div><dt>Sediu</dt><dd>Marghita, Bihor</dd></div>
      <div><dt>Proiecte în</dt><dd>Timiș și Arad</dd></div>
    </dl>
  </section>

  <section class="wrap projects" id="proiecte">
    <div class="head">
      <h2>Proiecte recente</h2>
      <a href={ROUTES.projects.ro} class="more">Toate proiectele și fotografiile</a>
    </div>
    <div class="p-list">
      {
        projects.map((p, i) => (
          <a href={ROUTES.projects.ro} class:list={['p', { first: i === 0 }]}>
            <img src={i === 0 ? p.photo.src : p.photo.sm} alt={`${p.title}, ${p.place}`} loading="lazy" />
            <span class="p-body">
              <span class="p-place">{p.place}, {p.county}</span>
              <span class="p-title">{p.title}</span>
            </span>
          </a>
        ))
      }
    </div>
  </section>

  <section class="kit" id="echipamente">
    <div class="wrap kit-grid">
      <img src={level.src} width={level.w} height={level.h} alt="Nivela digitală Leica Sprinter 250M pe șantierul din Dumbrăvița" loading="lazy" />
      <div>
        <h2>Echipamente Leica Geosystems</h2>
        <ul>
          {
            EQUIPMENT.map((e) => (
              <li>
                <strong>{e.name}</strong>
                <span>{t.equipment[e.key].kind}. {t.equipment[e.key].text}</span>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </section>

  <section class="wrap about" id="despre">
    <h2>Despre Road Consult</h2>
    <p>{t.about.story[0]}</p>
    <p>{t.about.story[1]}</p>
  </section>

  <section class="contact" id="contact">
    <div class="wrap contact-in">
      <div>
        <h2>Spune-ne despre proiectul tău</h2>
        <p>Trimite detaliile lucrării și revenim cu o ofertă. Pentru ceva urgent, scrie-ne pe WhatsApp.</p>
      </div>
      <div class="contact-actions">
        <a class="btn white" href={ROUTES.contact.ro}>Cere o ofertă</a>
        <a class="btn line" href={SITE.whatsapp}>WhatsApp {SITE.phoneDisplay}</a>
        <a class="mail" href={`mailto:${SITE.email}`}>{SITE.email}</a>
      </div>
    </div>
  </section>

  <footer class="wrap foot">
    <span class="logo" aria-hidden="true"></span>
    <p>{SITE.legalName}, CUI {SITE.cui}, {SITE.reg}<br />{ADDRESS_LINE}</p>
  </footer>
</ConceptLayout>

<style is:global>
  :root {
    --blue: #0b4f9c;
    --blue-dark: #083b75;
    --ink: #14202e;
    --soft: #4d5b6b;
    --mist: #eef2f6;
    --white: #ffffff;
  }
  * {
    box-sizing: border-box;
  }
  body {
    margin: 0;
    font-family: 'Schibsted Grotesk Variable', system-ui, sans-serif;
    color: var(--ink);
    background: var(--white);
    line-height: 1.6;
    font-size: 17px;
  }
  img {
    display: block;
    max-width: 100%;
  }
  a {
    color: inherit;
  }
  h1,
  h2 {
    margin: 0;
    line-height: 1.08;
    letter-spacing: -0.02em;
    font-weight: 700;
  }
  p {
    margin: 0;
  }
  :focus-visible {
    outline: 3px solid var(--blue);
    outline-offset: 3px;
  }
  .wrap {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 24px;
  }
  .top {
    position: absolute;
    z-index: 3;
    left: 0;
    right: 0;
    top: 0;
    display: flex;
    align-items: center;
    gap: 32px;
    padding: 20px max(24px, calc((100vw - 1152px) / 2));
    color: var(--white);
  }
  .logo {
    display: block;
    height: 32px;
    aspect-ratio: 425 / 80;
    background: currentColor;
    -webkit-mask: url('/logo.webp') left center / contain no-repeat;
    mask: url('/logo.webp') left center / contain no-repeat;
  }
  .top nav {
    margin-left: auto;
    display: flex;
    gap: 28px;
    font-weight: 500;
  }
  .top nav a {
    text-decoration: none;
  }
  .top nav a:hover {
    text-decoration: underline;
    text-underline-offset: 6px;
  }
  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 50px;
    padding: 0 24px;
    border-radius: 8px;
    font-weight: 600;
    text-decoration: none;
    background: var(--blue);
    color: var(--white);
  }
  .btn.small {
    min-height: 42px;
    padding: 0 18px;
    background: var(--white);
    color: var(--blue);
  }
  .btn.white {
    background: var(--white);
    color: var(--blue);
  }
  .btn.line {
    background: transparent;
    color: var(--white);
    box-shadow: inset 0 0 0 2px rgba(255, 255, 255, 0.6);
  }
  .hero {
    position: relative;
    min-height: 88vh;
    display: flex;
    align-items: flex-end;
    color: var(--white);
  }
  .hero-img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .hero-shade {
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, rgba(10, 20, 35, 0.55) 0%, rgba(10, 20, 35, 0.1) 35%, rgba(10, 20, 35, 0.75) 100%);
  }
  .hero-copy {
    position: relative;
    width: 100%;
    padding-bottom: 168px;
  }
  h1 {
    font-size: clamp(40px, 6vw, 80px);
    max-width: 13em;
  }
  .hero-copy p {
    margin-top: 20px;
    font-size: 20px;
    max-width: 32em;
    color: #e6ebf1;
  }
  /* The services as road direction signs: blue panel, inset white border, arrow. */
  .signs {
    position: relative;
    z-index: 2;
    margin-top: -112px;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 16px;
  }
  .sign {
    display: flex;
    gap: 16px;
    padding: 26px 22px 26px 26px;
    background: var(--blue);
    color: var(--white);
    text-decoration: none;
    border-radius: 12px;
    box-shadow: inset 0 0 0 4px var(--blue), inset 0 0 0 7px var(--white), 0 18px 40px rgba(10, 20, 35, 0.25);
    transition: background-color 0.15s ease;
  }
  .sign:hover {
    background: var(--blue-dark);
    box-shadow: inset 0 0 0 4px var(--blue-dark), inset 0 0 0 7px var(--white), 0 18px 40px rgba(10, 20, 35, 0.25);
  }
  .sign-in {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }
  .sign-title {
    font-size: 24px;
    font-weight: 700;
    line-height: 1.15;
  }
  .sign-text {
    font-size: 15px;
    color: #d6e2f1;
  }
  .sign-arrow {
    flex: none;
    width: 40px;
    height: 40px;
    fill: var(--white);
    margin-top: -4px;
  }
  .intro {
    display: grid;
    grid-template-columns: minmax(0, 8fr) minmax(0, 4fr);
    gap: 64px;
    padding-top: 112px;
    align-items: end;
  }
  .intro-big {
    font-size: clamp(24px, 2.6vw, 34px);
    line-height: 1.3;
    letter-spacing: -0.01em;
  }
  .facts {
    margin: 0;
  }
  .facts div {
    display: flex;
    justify-content: space-between;
    gap: 16px;
    padding: 12px 0;
    border-bottom: 1px solid #d5dde6;
  }
  .facts dt {
    color: var(--soft);
  }
  .facts dd {
    margin: 0;
    font-weight: 600;
  }
  .projects {
    padding-top: 112px;
  }
  .head {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: baseline;
    gap: 16px;
    margin-bottom: 32px;
  }
  h2 {
    font-size: clamp(30px, 3.4vw, 44px);
  }
  .more {
    color: var(--blue);
    font-weight: 600;
  }
  .p-list {
    display: grid;
    grid-template-columns: 2fr 1fr 1fr;
    grid-template-rows: auto auto;
    gap: 20px;
  }
  .p {
    display: flex;
    flex-direction: column;
    gap: 12px;
    text-decoration: none;
  }
  .p img {
    width: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    border-radius: 10px;
  }
  .p.first {
    grid-row: span 2;
  }
  .p.first img {
    aspect-ratio: auto;
    flex: 1;
    min-height: 0;
  }
  .p-body {
    display: flex;
    flex-direction: column;
  }
  .p-place {
    color: var(--soft);
    font-size: 15px;
  }
  .p-title {
    font-weight: 600;
    font-size: 19px;
  }
  .p:hover .p-title {
    color: var(--blue);
  }
  .kit {
    margin-top: 112px;
    background: var(--mist);
    padding: 96px 0;
  }
  .kit-grid {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
    gap: 64px;
    align-items: center;
  }
  .kit-grid img {
    border-radius: 12px;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    width: 100%;
    height: auto;
  }
  .kit ul {
    list-style: none;
    margin: 28px 0 0;
    padding: 0;
  }
  .kit li {
    display: flex;
    flex-direction: column;
    padding: 16px 0;
    border-top: 1px solid #cfd8e2;
  }
  .kit li strong {
    font-size: 20px;
  }
  .kit li span {
    color: var(--soft);
  }
  .about {
    padding-top: 112px;
    display: grid;
    grid-template-columns: minmax(0, 4fr) minmax(0, 4fr) minmax(0, 4fr);
    gap: 40px;
  }
  .about p {
    color: var(--soft);
  }
  .contact {
    margin-top: 112px;
    background: var(--blue);
    color: var(--white);
    padding: 80px 0;
  }
  .contact-in {
    display: grid;
    grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
    gap: 48px;
    align-items: center;
  }
  .contact p {
    margin-top: 16px;
    color: #d6e2f1;
    max-width: 30em;
  }
  .contact-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    align-items: center;
  }
  .mail {
    width: 100%;
    color: var(--white);
    font-weight: 600;
  }
  .foot {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: center;
    gap: 24px;
    padding-top: 40px;
    padding-bottom: 40px;
    color: var(--soft);
    font-size: 14px;
  }
  .foot .logo {
    color: var(--ink);
    height: 26px;
  }
  @media (max-width: 960px) {
    .top nav {
      display: none;
    }
    .top .btn {
      margin-left: auto;
    }
    .hero {
      min-height: 78vh;
    }
    .hero-copy {
      padding-bottom: 64px;
    }
    .signs {
      margin-top: 24px;
      grid-template-columns: minmax(0, 1fr);
    }
    .intro,
    .kit-grid,
    .about,
    .contact-in {
      grid-template-columns: minmax(0, 1fr);
      gap: 32px;
    }
    .p-list {
      grid-template-columns: 1fr 1fr;
    }
    .p.first {
      grid-column: span 2;
      grid-row: auto;
    }
    .p.first img {
      aspect-ratio: 4 / 3;
    }
  }
  @media (max-width: 520px) {
    .top {
      gap: 12px;
    }
    .logo {
      height: 26px;
    }
    .p-list {
      grid-template-columns: minmax(0, 1fr);
    }
    .p.first {
      grid-column: auto;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .sign {
      transition: none;
    }
  }
</style>
