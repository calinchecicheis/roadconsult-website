---
import Logo from './Logo.astro';
import { LANGS, LANG_LABELS, ROUTES, T, type Lang, type PageKey } from '../i18n';

interface Props {
  lang: Lang;
  page: PageKey;
}
const { lang, page } = Astro.props;
const t = T[lang];
const home = ROUTES.home[lang];
const links = [
  { href: ROUTES.services[lang], label: t.nav.services, active: ['services', 'survey', 'planning', 'consulting'].includes(page) },
  { href: ROUTES.projects[lang], label: t.nav.projects, active: page === 'projects' },
  { href: `${home}#echipamente`, label: t.nav.equipment, active: false },
  { href: ROUTES.about[lang], label: t.nav.about, active: page === 'about' },
  { href: ROUTES.contact[lang], label: t.nav.contact, active: page === 'contact' },
];
---

<header class="site-header">
  <div class="container bar">
    <a href={home} class="brand"><Logo /></a>

    <nav aria-label={t.nav.menu} class="nav">
      {links.map((l) => <a href={l.href} aria-current={l.active ? 'page' : undefined}>{l.label}</a>)}
    </nav>

    <div class="actions">
      <button type="button" class="icon-btn" id="theme-toggle" aria-label={t.nav.theme} title={t.nav.theme}>
        <svg class="moon" aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"></path></svg>
        <svg class="sun" aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="4"></circle><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"></path></svg>
      </button>
      <details class="dropdown lang">
        <summary aria-label={t.nav.language}>
          <svg aria-hidden="true" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"></circle><path d="M2 12h20M12 2a15 15 0 0 1 0 20M12 2a15 15 0 0 0 0 20"></path></svg>
          <span class="mono">{LANG_LABELS[lang].short}</span>
        </summary>
        <ul>
          {
            LANGS.map((l) => (
              <li>
                <a href={ROUTES[page][l]} hreflang={l} lang={l} data-lang={l} aria-current={l === lang ? 'true' : undefined}>
                  {LANG_LABELS[l].name}
                </a>
              </li>
            ))
          }
        </ul>
      </details>
      <a href={ROUTES.contact[lang]} class="btn btn-yellow quote">{t.cta.quote}</a>
      <details class="dropdown burger">
        <summary aria-label={t.nav.menu}>
          <svg aria-hidden="true" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M4 7h16M4 12h16M4 17h16"></path></svg>
        </summary>
        <ul>
          <li><a href={home}>{t.nav.home}</a></li>
          {links.map((l) => <li><a href={l.href}>{l.label}</a></li>)}
        </ul>
      </details>
    </div>
  </div>
</header>

<script is:inline>
  // Remember the language a visitor picks, so the homepage stops auto-redirecting them.
  document.querySelectorAll('[data-lang]').forEach(function (a) {
    a.addEventListener('click', function () {
      document.cookie = 'lang=' + a.getAttribute('data-lang') + ';path=/;max-age=31536000;SameSite=Lax';
    });
  });
  // Light / dark theme toggle, remembered per visitor.
  document.getElementById('theme-toggle').addEventListener('click', function () {
    var next = document.documentElement.getAttribute('data-theme') === 'dark' ? 'light' : 'dark';
    document.documentElement.setAttribute('data-theme', next);
    try { localStorage.setItem('theme', next); } catch (e) {}
  });
  // Close open menus when clicking elsewhere or following a link inside them.
  document.addEventListener('click', function (e) {
    document.querySelectorAll('details.dropdown[open]').forEach(function (d) {
      if (!d.contains(e.target) || e.target.closest('a')) d.removeAttribute('open');
    });
  });
</script>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 20;
    background: var(--header-bg);
    backdrop-filter: saturate(1.4) blur(10px);
    border-bottom: 1px solid var(--line);
  }
  .bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    min-height: 72px;
  }
  .brand {
    display: block;
    color: var(--text);
  }
  .nav {
    display: flex;
    gap: 2px;
    font-size: 15px;
    font-weight: 500;
  }
  .nav a {
    text-decoration: none;
    padding: 8px 12px;
    border-radius: var(--radius);
  }
  .nav a:hover {
    background: var(--surface-alt);
  }
  .nav a[aria-current='page'] {
    box-shadow: inset 0 -3px 0 var(--yellow);
    border-radius: 0;
  }
  .actions {
    display: flex;
    align-items: center;
    gap: 8px;
  }
  .icon-btn,
  .dropdown summary {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 6px;
    min-width: 44px;
    height: 44px;
    padding: 0 10px;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--surface);
    color: var(--text);
    font-size: 14px;
    cursor: pointer;
    list-style: none;
  }
  .dropdown summary::-webkit-details-marker {
    display: none;
  }
  .icon-btn:hover,
  .dropdown summary:hover {
    border-color: var(--line-strong);
  }
  .icon-btn .sun,
  :global([data-theme='dark']) .icon-btn .moon {
    display: none;
  }
  :global([data-theme='dark']) .icon-btn .sun {
    display: block;
  }
  .dropdown {
    position: relative;
  }
  .dropdown ul {
    position: absolute;
    right: 0;
    top: calc(100% + 8px);
    margin: 0;
    padding: 6px;
    list-style: none;
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow);
    min-width: 180px;
  }
  .dropdown a {
    display: block;
    padding: 10px 14px;
    border-radius: var(--radius);
    text-decoration: none;
    font-weight: 500;
  }
  .dropdown a:hover,
  .dropdown a[aria-current='true'] {
    background: var(--surface-alt);
  }
  .quote {
    white-space: nowrap;
    min-height: 44px;
    padding: 10px 18px;
  }
  .burger {
    display: none;
  }
  @media (max-width: 1040px) {
    .nav {
      display: none;
    }
    .burger {
      display: block;
    }
  }
  @media (max-width: 520px) {
    .quote {
      display: none;
    }
    .brand :global(.logo) {
      --h: 28px !important;
    }
  }
</style>
