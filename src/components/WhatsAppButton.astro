---
import { SITE } from '../config';
import { T, type Lang } from '../i18n';
interface Props {
  lang: Lang;
}
const t = T[Astro.props.lang];
---

<a class="wa" href={SITE.whatsapp} target="_blank" rel="noopener" aria-label={t.cta.whatsapp}>
  <svg aria-hidden="true" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 11.5a8.4 8.4 0 0 1-12.6 7.3L3 21l2.2-5.4A8.4 8.4 0 1 1 21 11.5z"></path><path d="M9 9.5c.3 2.2 2.3 4.2 4.5 4.5l1-1.2 2 1-.5 1.5c-3.6.4-7.7-3.7-7.3-7.3L10.2 7.5l1 2-1.2 1"></path></svg>
</a>

<style>
  .wa {
    position: fixed;
    right: 20px;
    bottom: 20px;
    z-index: 30;
    width: 60px;
    height: 60px;
    border-radius: 50%;
    background: #1f9d55;
    color: #ffffff;
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow: 0 8px 24px rgba(21, 25, 29, 0.25);
  }
  .wa:hover {
    background: #17803f;
    color: #ffffff;
  }
</style>
