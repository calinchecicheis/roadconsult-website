---
// One shared full-screen photo viewer for every PhotoCarousel on the page.
import { T, type Lang } from '../i18n';
interface Props {
  lang: Lang;
}
const t = T[Astro.props.lang].projects;
---

<dialog class="lightbox" id="lightbox" aria-label={t.galleryTitle}>
  <img alt="" />
  <p class="counter mono" aria-live="polite"></p>
  <button type="button" class="lb-btn lb-close" data-close aria-label={t.close}>
    <svg aria-hidden="true" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M6 6l12 12M18 6L6 18" /></svg>
  </button>
  <button type="button" class="lb-btn lb-prev" data-lb-prev aria-label={t.prev}>
    <svg aria-hidden="true" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M15 18l-6-6 6-6" /></svg>
  </button>
  <button type="button" class="lb-btn lb-next" data-lb-next aria-label={t.next}>
    <svg aria-hidden="true" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 18l6-6-6-6" /></svg>
  </button>
</dialog>

<script>
  const dialog = document.getElementById('lightbox') as HTMLDialogElement | null;
  const carousels = document.querySelectorAll<HTMLElement>('[data-carousel]');

  carousels.forEach((c) => {
    const track = c.querySelector<HTMLElement>('.track')!;
    const prev = c.querySelector<HTMLButtonElement>('[data-prev]')!;
    const next = c.querySelector<HTMLButtonElement>('[data-next]')!;
    const update = () => {
      prev.disabled = track.scrollLeft <= 2;
      next.disabled = track.scrollLeft + track.clientWidth >= track.scrollWidth - 2;
    };
    prev.addEventListener('click', () => track.scrollBy({ left: -track.clientWidth * 0.8 }));
    next.addEventListener('click', () => track.scrollBy({ left: track.clientWidth * 0.8 }));
    track.addEventListener('scroll', update, { passive: true });
    window.addEventListener('resize', update);
    update();
  });

  if (dialog) {
    const img = dialog.querySelector('img')!;
    const counter = dialog.querySelector<HTMLElement>('.counter')!;
    let slides: HTMLButtonElement[] = [];
    let index = 0;
    const show = (i: number) => {
      index = (i + slides.length) % slides.length;
      const s = slides[index];
      img.src = s.dataset.full!;
      img.width = Number(s.dataset.w);
      img.height = Number(s.dataset.h);
      img.alt = s.getAttribute('aria-label') || '';
      counter.textContent = `${index + 1} / ${slides.length}`;
    };
    document.addEventListener('click', (e) => {
      // "See all photos" buttons open their gallery at the first photo.
      const all = (e.target as HTMLElement).closest<HTMLElement>('[data-open-gallery]');
      if (all) {
        all.closest('[data-gallery]')?.querySelector<HTMLButtonElement>('.slide')?.click();
        return;
      }
      const slide = (e.target as HTMLElement).closest<HTMLButtonElement>('.slide');
      if (!slide) return;
      slides = Array.from(slide.closest('[data-carousel],[data-gallery]')!.querySelectorAll<HTMLButtonElement>('.slide'));
      show(slides.indexOf(slide));
      dialog.showModal();
    });
    dialog.querySelector('[data-close]')!.addEventListener('click', () => dialog.close());
    dialog.querySelector('[data-lb-prev]')!.addEventListener('click', () => show(index - 1));
    dialog.querySelector('[data-lb-next]')!.addEventListener('click', () => show(index + 1));
    dialog.addEventListener('click', (e) => {
      if (e.target === dialog) dialog.close();
    });
    dialog.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowLeft') show(index - 1);
      if (e.key === 'ArrowRight') show(index + 1);
    });
    // Swipe left / right on touch screens.
    let x0: number | null = null;
    dialog.addEventListener('touchstart', (e) => (x0 = e.touches[0].clientX), { passive: true });
    dialog.addEventListener('touchend', (e) => {
      if (x0 === null) return;
      const dx = e.changedTouches[0].clientX - x0;
      if (Math.abs(dx) > 40) show(index + (dx < 0 ? 1 : -1));
      x0 = null;
    });
  }
</script>

<style>
  .lightbox {
    width: 100vw;
    height: 100vh;
    max-width: none;
    max-height: none;
    margin: 0;
    padding: 0;
    border: 0;
    background: rgba(10, 12, 14, 0.94);
    color: #ffffff;
  }
  .lightbox[open] {
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .lightbox::backdrop {
    background: rgba(10, 12, 14, 0.94);
  }
  .lightbox img {
    max-width: calc(100vw - 32px);
    max-height: calc(100vh - 120px);
    width: auto;
    height: auto;
    object-fit: contain;
    border-radius: 4px;
  }
  .counter {
    position: absolute;
    left: 50%;
    bottom: 24px;
    transform: translateX(-50%);
    font-size: 13px;
    color: #a3adb6;
  }
  .lb-btn {
    position: absolute;
    width: 48px;
    height: 48px;
    display: flex;
    align-items: center;
    justify-content: center;
    border: 1px solid rgba(255, 255, 255, 0.2);
    border-radius: 6px;
    background: rgba(21, 25, 29, 0.7);
    color: #ffffff;
    cursor: pointer;
  }
  .lb-btn:hover {
    border-color: #ffc20e;
  }
  .lb-close {
    top: 16px;
    right: 16px;
  }
  .lb-prev {
    left: 16px;
    top: 50%;
    transform: translateY(-50%);
  }
  .lb-next {
    right: 16px;
    top: 50%;
    transform: translateY(-50%);
  }
  @media (max-width: 640px) {
    .lb-prev,
    .lb-next {
      top: auto;
      bottom: 12px;
      transform: none;
    }
  }
</style>
