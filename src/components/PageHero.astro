---
// Top of every inner page: breadcrumb, kicker, title and lead, on a panel with contour lines.
import Contours from './Contours.astro';
import { ROUTES, T, type Lang } from '../i18n';
interface Props {
  lang: Lang;
  kicker: string;
  title: string;
  lead?: string;
  crumbs?: { label: string; href?: string }[];
}
const { lang, kicker, title, lead, crumbs = [] } = Astro.props;
const t = T[lang];
---

<section class="container top">
  <div class="hero panel">
    <div class="bg" aria-hidden="true"><Contours /></div>
    <div class="content">
      <nav aria-label="Breadcrumb" class="crumbs mono">
        <a href={ROUTES.home[lang]}>{t.nav.home}</a>
        {
          crumbs.map((c) => (
            <>
              <span aria-hidden="true">/</span>
              {c.href ? <a href={c.href}>{c.label}</a> : <span aria-current="page">{c.label}</span>}
            </>
          ))
        }
      </nav>
      <p class="kicker">{kicker}</p>
      <h1>{title}</h1>
      {lead && <p class="lead">{lead}</p>}
      <slot />
    </div>
  </div>
</section>

<style>
  .top {
    padding-top: 24px;
  }
  .hero {
    position: relative;
    overflow: hidden;
    padding: 56px 48px;
  }
  .bg {
    position: absolute;
    inset: 0 -10% 0 45%;
    -webkit-mask-image: linear-gradient(90deg, transparent, #000 40%);
    mask-image: linear-gradient(90deg, transparent, #000 40%);
  }
  .content {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 18px;
    max-width: 760px;
  }
  .crumbs {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    font-size: 12.5px;
    color: var(--label);
  }
  .crumbs a {
    color: var(--label);
  }
  .kicker {
    margin: 8px 0 0;
  }
  h1 {
    font-size: clamp(34px, 4.6vw, 54px);
    line-height: 1.06;
  }
  @media (max-width: 640px) {
    .hero {
      padding: 32px 24px;
    }
    .bg {
      inset: 0 -40% 0 20%;
      opacity: 0.6;
    }
  }
</style>
