---
import Layout from '../../layouts/Layout.astro';
import PageHero from '../PageHero.astro';
import { T, type Lang } from '../../i18n';
import { postsIn, postPath, readingMinutes, formatDate } from '../../lib/blog';
interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = T[lang];
const posts = await postsIn(lang);
---

<Layout lang={lang} page="blog" title={t.blog.metaTitle} description={t.blog.metaDescription}>
  <PageHero lang={lang} kicker={t.nav.blog} title={t.blog.title} lead={t.blog.lead} crumbs={[{ label: t.nav.blog }]} />

  <section class="container list-wrap">
    {
      posts.length === 0 ? (
        <p class="panel empty">{t.blog.empty}</p>
      ) : (
        <ul class="list">
          {posts.map((p) => (
            <li>
              <a href={postPath(p)} class="post">
                <p class="meta mono">
                  <time datetime={p.data.date.toISOString()}>{formatDate(p.data.date, lang)}</time>
                  <span>
                    {readingMinutes(p.body)} {t.blog.minutes}
                  </span>
                </p>
                <div>
                  <h2>{p.data.title}</h2>
                  <p class="desc">{p.data.description}</p>
                </div>
              </a>
            </li>
          ))}
        </ul>
      )
    }
  </section>
</Layout>

<style>
  .list-wrap {
    padding-top: 40px;
    padding-bottom: 112px;
  }
  .list {
    list-style: none;
    margin: 0;
    padding: 0;
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
  }
  li + li {
    border-top: 1px solid var(--line);
  }
  .post {
    display: grid;
    grid-template-columns: 200px minmax(0, 1fr);
    gap: 8px 40px;
    padding: 32px;
    text-decoration: none;
  }
  .post h2 {
    font-size: clamp(22px, 2.6vw, 28px);
    max-width: 26em;
  }
  .post:hover h2 {
    text-decoration: underline;
    text-decoration-color: var(--yellow);
    text-decoration-thickness: 3px;
    text-underline-offset: 6px;
  }
  .meta {
    display: flex;
    flex-direction: column;
    gap: 4px;
    font-size: 13px;
    color: var(--label);
    padding-top: 6px;
  }
  .desc {
    margin-top: 10px;
    color: var(--text-soft);
    font-size: 17px;
    max-width: 40em;
  }
  .empty {
    color: var(--text-soft);
  }
  @media (max-width: 720px) {
    .post {
      grid-template-columns: minmax(0, 1fr);
      padding: 24px;
    }
    .meta {
      flex-direction: row;
      gap: 16px;
      padding-top: 0;
    }
  }
</style>
