---
import Logo from './Logo.astro';
import { SITE, ADDRESS_LINE } from '../config';
import { ROUTES, SERVICE_KEYS, T, type Lang } from '../i18n';
interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = T[lang];
const year = new Date().getFullYear();
const redirect = new URL(ROUTES.thanks[lang], SITE.url).href;
---

<footer class="site-footer">
  <div class="roadline" aria-hidden="true"></div>
  <div class="container">
    <div class="cols">
      <div class="col about">
        <Logo height={30} />
        <p class="muted">{t.footer.tagline}</p>
        <p class="legal-data mono">
          {SITE.legalName}<br />
          CUI {SITE.cui} · {SITE.reg}<br />
          {ADDRESS_LINE}
        </p>
      </div>
      <div class="col">
        <p class="h">{t.nav.services}</p>
        {SERVICE_KEYS.map((k) => <a href={ROUTES[k][lang]}>{t.services[k].title}</a>)}
        <a href={ROUTES.projects[lang]}>{t.nav.projects}</a>
        <a href={ROUTES.about[lang]}>{t.nav.about}</a>
      </div>
      <div class="col">
        <p class="h">{t.footer.contact}</p>
        <a href={SITE.whatsapp} target="_blank" rel="noopener">WhatsApp {SITE.phoneDisplay}</a>
        <a href={`mailto:${SITE.email}`}>{SITE.email}</a>
        <a href={SITE.facebook} target="_blank" rel="noopener">Facebook</a>
        <a href={SITE.linkedin} target="_blank" rel="noopener">LinkedIn</a>
      </div>
      <form class="col newsletter" action="https://api.web3forms.com/submit" method="POST">
        <input type="hidden" name="access_key" value={SITE.web3formsKey} />
        <input type="hidden" name="subject" value={t.newsletter.subject} />
        <input type="hidden" name="redirect" value={redirect} />
        <input type="checkbox" name="botcheck" class="sr-only" tabindex="-1" autocomplete="off" aria-hidden="true" />
        <label for={`nl-${lang}`} class="h">{t.newsletter.label}</label>
        <div class="row">
          <input id={`nl-${lang}`} type="email" name="email" placeholder={t.newsletter.placeholder} autocomplete="email" required />
          <button type="submit" class="btn btn-dark">{t.newsletter.submit}</button>
        </div>
      </form>
    </div>
    <p class="legal">
      <span>© {year} Road Consult. {t.footer.rights}</span>
      <a href={ROUTES.privacy[lang]}>{t.footer.privacy}</a>
      <span>{t.footer.madeBy} <a href="https://techsphere.ro" target="_blank" rel="noopener">Techsphere</a></span>
    </p>
  </div>
</footer>

<style>
  .site-footer {
    margin-top: 112px;
    padding: 0 0 40px;
    background: var(--surface);
    border-top: 1px solid var(--line);
  }
  .cols {
    display: grid;
    grid-template-columns: 1.4fr 1fr 1fr 1.5fr;
    gap: 32px;
    padding-top: 56px;
  }
  .col {
    display: flex;
    flex-direction: column;
    gap: 8px;
    font-size: 15px;
  }
  .col a {
    text-decoration: none;
  }
  .col a:hover {
    text-decoration: underline;
  }
  .about {
    gap: 16px;
  }
  .h {
    font-weight: 650;
    margin-bottom: 4px;
  }
  .muted {
    color: var(--text-soft);
    max-width: 22em;
  }
  .legal-data {
    font-size: 12.5px;
    line-height: 1.8;
    color: var(--label);
  }
  .row {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }
  .row input {
    flex: 1 1 200px;
    font: inherit;
    padding: 12px 14px;
    border: 1px solid var(--line-strong);
    border-radius: var(--radius);
    background: var(--bg);
    color: var(--text);
    min-height: 48px;
  }
  .legal {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 24px;
    margin-top: 48px;
    padding-top: 20px;
    border-top: 1px solid var(--line);
    font-size: 13px;
    color: var(--text-soft);
  }
  .legal a {
    color: inherit;
  }
  @media (max-width: 960px) {
    .cols {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (max-width: 640px) {
    .cols {
      grid-template-columns: minmax(0, 1fr);
    }
    .site-footer {
      margin-top: 72px;
      padding-bottom: 96px;
    }
  }
</style>
